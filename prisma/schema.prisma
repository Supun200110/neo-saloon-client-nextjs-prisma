// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User{
  id String @id @default(uuid()) 
  email String @unique 
  phone String? @unique
  firstName String
  lastName String
  password String
  role String @default("CUSTOMER")
  status String @default("ACTIVE") // ACTIVE,BANNED, SUSPENDED
  createdAt DateTime @default(now())
  lastLogin DateTime?
  privileges String[] @default([])
  profileImage String @default("/images/default-profile.png")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model Product{
  id String @id @default(uuid()) 
  sku String @unique
  name String
  altNames String[]@default([])
  description String
  stock Int @default(0)
  status ProductStatus @default(ACTIVE)
  price Float @default(0)
  compareAt Float?
  brand String?
  model String?  
  media Media[]
}
model Media{
  
  id String @id @default(uuid()) 
  url String
  type String
  productId String
  product Product @relation(fields: [productId], references: [id])
  
}